# CARTO Maps API Key
VITE_CARTO_API_KEY=cb1_2w7k_1_41073939576e71e4cdbd81fb

# Supabase PostgreSQL Database Configuration
# Obtain your project URL and public anon key from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth 2.0 / Google Identity Services (Web Client ID from Google Cloud Console)
# Frontend client ID (exposed to browser for GIS button rendering)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Backend Google verification (used by Express server to verify Google ID tokens)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Backend Application Session JWT Secret (NEVER prefix with VITE_ or expose to client)
JWT_SECRET=your-secure-backend-jwt-secret-min-32-chars

